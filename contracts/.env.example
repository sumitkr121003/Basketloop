# BasketLoop Smart Contracts — Environment Variables
# Copy this file to .env and configure your keys for public testnet deployment

# ==============================================================================
# 1. Target Network Selection
# ==============================================================================
# Choose which network deploy.js should target: 'robinhoodTestnet' or 'arbitrumSepolia'
DEPLOY_NETWORK=robinhoodTestnet

# ==============================================================================
# 2. Deployer & Keeper Private Keys
# ==============================================================================
# Private key of the deployer wallet (must be funded with testnet ETH for gas).
# NEVER commit real private keys or mainnet funds. For testnet use only.
DEPLOYER_PRIVATE_KEY=

# Optional: Private key of the keeper relayer account
KEEPER_PRIVATE_KEY=

# Optional: Address of designated keeper daemon relayer (if omitted, defaults to keeper signer or deployer)
KEEPER_ADDRESS=

# Optional: Address to receive minted test ERC-20 tokens (if omitted, defaults to deployer)
TEST_USER_ADDRESS=

# ==============================================================================
# 3. Robinhood Chain Testnet (Arbitrum Orbit L2 - Chain ID: 46630)
# ==============================================================================
# Official Live RPC:
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_TESTNET_CHAIN_ID=46630

# Live Faucets & Explorers:
#   - Official Testnet Faucet: https://faucet.testnet.chain.robinhood.com
#   - Block Explorer:          https://explorer.testnet.chain.robinhood.com
#   - Community Web3 Faucet:   https://faucet.trade/robinhood-testnet-eth-faucet

# ==============================================================================
# 4. Arbitrum Sepolia Testnet (Chain ID: 421614)
# ==============================================================================
# Official Live RPC:
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Alternative Live RPCs:
#   - https://arbitrum-sepolia-rpc.publicnode.com
#   - https://arbitrum-sepolia.blockpi.network/v1/rpc/public
#   - https://arbitrum-sepolia.drpc.org

# Live Faucets & Bridges:
#   - QuickNode Faucet:        https://faucet.quicknode.com/arbitrum/sepolia
#   - Chainlink Faucet:        https://faucets.chain.link/arbitrum-sepolia
#   - Alchemy Faucet:          https://www.alchemy.com/faucets/arbitrum-sepolia
#   - Official Arbitrum Bridge: https://bridge.arbitrum.io/?destinationChain=arbitrum-sepolia&sourceChain=sepolia
#   - LearnWeb3 Faucet:        https://learnweb3.io/faucets/arbitrum_sepolia
#   - Sepolia PoW L1 Faucet:   https://sepolia-faucet.pk910.de/
#   - Block Explorer:          https://sepolia.arbiscan.io
