# BasketLoop Keeper Daemon — Environment Variables
# Copy this file to .env and fill in your values

# --- RPC Configuration ---
# Live Testnet RPCs:
# Robinhood Chain Testnet (Chain ID 46630): https://rpc.testnet.chain.robinhood.com/rpc
# Arbitrum Sepolia (Chain ID 421614):       https://sepolia-rollup.arbitrum.io/rpc
# Local Devnode:                            http://127.0.0.1:8545
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# --- Contract Addresses ---
# BasketLoopManager deployed address
BASKET_LOOP_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Keeper Wallet ---
# Private key of the developer relayer wallet (funded with testnet ETH for gas)
# NEVER commit real private keys. For testnet use only.
KEEPER_PRIVATE_KEY=

# --- Polling Configuration ---
# Polling interval in milliseconds (default: 30000 = 30 seconds)
POLL_INTERVAL_MS=30000

# --- Gas Configuration ---
# EIP-1559 max priority fee in gwei
DEFAULT_PRIORITY_FEE_GWEI=0.1

# --- Logging ---
# Log level: debug, info, warn, error
LOG_LEVEL=info
